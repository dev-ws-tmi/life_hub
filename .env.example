# ================================================
# ESTUDI360 — Variables d'Entorn
# Copia aquest fitxer com .env i omple els valors
# MAI commitejis el fitxer .env al repositori!
# ================================================

# ── Firebase Client (Vite exposa VITE_* al frontend) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── App Config ──
VITE_APP_ENV=development
VITE_APP_VERSION=0.1.0
VITE_APP_NAME=Estudi360

# ── Cloud Functions (Server-side, NO exposis al frontend) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── IA (Futur) ──
OPENAI_API_KEY=

# ── Email ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# ── Stripe (Futur) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Seguretat ──
JWT_SECRET=
ENCRYPTION_KEY=

# ── Rate Limiting ──
RATE_LIMIT_PER_USER=100
RATE_LIMIT_PER_IP=1000
