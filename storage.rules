rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── DEFAULT DENY ──────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ── USER AVATARS ──────────────────────────────────────────
    match /users/{userId}/avatar/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024  // 2MB màxim
        && request.resource.contentType.matches('image/.*');
    }

    // ── TASK ATTACHMENTS ──────────────────────────────────────
    match /users/{userId}/tasks/{taskId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;  // 10MB màxim
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── EXAM ATTACHMENTS ─────────────────────────────────────
    match /users/{userId}/exams/{examId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024;  // 20MB màxim
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
