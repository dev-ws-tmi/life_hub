{
  "name": "estudi360",
  "version": "0.1.0",
  "private": true,
  "description": "Estudi360 — Gestor acadèmic intel·ligent PWA",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=shared && npm run build --workspace=frontend",
    "build:functions": "npm run build --workspace=backend",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace=frontend && npm run typecheck --workspace=backend",
    "test": "npm run test --workspace=frontend",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy": "npm run build:functions && firebase deploy"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
